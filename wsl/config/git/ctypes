#!/bin/bash

# Conventional Commits helpers
# Format: <type>(<scope>): <description>   (scope optional)
# Spec: https://www.conventionalcommits.org

# Define valid commit types (lowercase, per Conventional Commits)
CTYPES="feat fix refactor docs style perf test chore"

# Resolve a type or its short alias to the canonical type name.
# Returns the type on stdout, or non-zero if invalid.
_ctype_resolve() {
    case "$1" in
        feat|f)     echo "feat" ;;
        fix|b)      echo "fix" ;;
        refactor|r) echo "refactor" ;;
        docs|d)     echo "docs" ;;
        style|s)    echo "style" ;;
        perf|p)     echo "perf" ;;
        test|t)     echo "test" ;;
        chore|c)    echo "chore" ;;
        *)          return 1 ;;
    esac
}

# Commit with a Conventional Commits message.
#   gcm <type> <message>            -> type: message
#   gcm <type> <scope> <message>    -> type(scope): message
gcm() {
    local type scope message

    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        gchelp
        return 1
    fi

    if ! type="$(_ctype_resolve "$1")"; then
        FAIL "Invalid type: $1" 2>/dev/null || echo "Invalid type: $1"
        gchelp
        return 1
    fi

    if [ "$#" -eq 3 ]; then
        scope="$2"
        message="$3"
        git commit -m "${type}(${scope}): ${message}"
    else
        message="$2"
        git commit -m "${type}: ${message}"
    fi
}

# Stage all changes, then commit (same args as gcm).
gcam() {
    git add .
    gcm "$@"
}

# Print usage and the Conventional Commits cheat sheet.
gchelp() {
    cat <<'EOF'
Conventional Commits helpers
============================

Usage:
  gcm  <type> [scope] <message>    Commit with a conventional message
  gcam <type> [scope] <message>    git add . , then commit
  gchelp                           Show this help

Format produced:
  <type>: <message>                (no scope)
  <type>(<scope>): <message>       (with scope)

Types (short alias):
  feat (f)      A new feature
  fix  (b)      A bug fix
  refactor (r)  Code change that neither fixes a bug nor adds a feature
  docs (d)      Documentation only
  style (s)     Formatting; no code-meaning change
  perf (p)      Performance improvement
  test (t)      Adding or fixing tests
  chore (c)     Tooling, deps, housekeeping

Scope = optional area of the codebase, e.g. auth, api, bash.

Examples:
  gcm feat "add login endpoint"          -> feat: add login endpoint
  gcm fix auth "handle expired token"    -> fix(auth): handle expired token
  gcm f api "paginate results (BE-34)"   -> feat(api): paginate results (BE-34)
  gcam chore deps "bump terraform"       -> chore(deps): bump terraform

Manual equivalent (no helper):
  git commit -m "feat(auth): add login endpoint"

Add an issue ref by writing it into the message, e.g. "... (BE-34)".
EOF
}
